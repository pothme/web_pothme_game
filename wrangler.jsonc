{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podeumgo",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-04",
  "vars": {
    "KOREAN_CHARTS_ENABLED": "true",
    "CLOUDFLARE_ACCOUNT_ID": "7b01ec2979a7a8a5c6cad40b2adbf420",
    "ADMIN_AUTH_MODE": "google",
    "ADMIN_OWNER_EMAIL": "showwingwing@gmail.com",
    "ADMIN_BASE_URL": "https://podeumgo.podeumgo.workers.dev",
    "GOOGLE_CLIENT_ID": "670507263279-p8mbse16agv1grm8jhgvn684ucjn0ljo.apps.googleusercontent.com"
  },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "CLASSROOM", "class_name": "Classroom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Classroom"] }],
  "observability": { "enabled": false }
}
